// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "webpack-dev",
            "type": "npm",
            "script": "webpack-dev",
            "isBackground": true,
            "problemMatcher": [
                {
                    "owner": "webpack",
                    "source": "webpack",
                    "applyTo": "allDocuments",
                    "fileLocation": "absolute",
                    "pattern": [
                        {
                            "regexp": "^\\[tsl\\] ERROR in (.+)\\((\\d+),(\\d+)\\)\\s*$",
                            "file": 1,
                            "line": 2,
                            "column": 3
                        },
                        {
                            "regexp": "^\\s*(TS\\d+):\\s*(.*)$",
                            "code": 1,
                            "message": 2
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "^\\s*\\[webpack-cli\\] Compiler(?: '[^']+')? starting\\.\\.\\.\\s*$",
                        "endsPattern": "^webpack(?: \\S+)? compiled\\b.*$"
                    }
                },
                {
                    "base": "$tsc",
                    "owner": "webpack",
                    "source": "webview TypeScript",
                    "applyTo": "allDocuments",
                    "fileLocation": ["relative", "${workspaceFolder}/webview-ui"],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "^\\s*\\[webpack-cli\\] Compiler(?: '[^']+')? starting\\.\\.\\.\\s*$",
                        "endsPattern": "^webpack(?: \\S+)? compiled\\b.*$"
                    }
                },
                {
                    "base": "$eslint-stylish",
                    "owner": "webpack",
                    "source": "webpack ESLint",
                    "applyTo": "allDocuments",
                    "fileLocation": "absolute",
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": "^\\s*\\[webpack-cli\\] Compiler(?: '[^']+')? starting\\.\\.\\.\\s*$",
                        "endsPattern": "^webpack(?: \\S+)? compiled\\b.*$"
                    }
                }
            ]
        },
        {
            "label": "webpack",
            "type": "npm",
            "script": "webpack"
        },
        {
            "label": "test-compile",
            "type": "npm",
            "script": "test-compile"
        },
        {
            "label": "dev:webview",
            "type": "npm",
            "script": "dev:webview",
            "problemMatcher": {
                "base": "$tsc-watch",
                "fileLocation": "absolute",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^(?:.* page reload |\\[TypeScript\\]).*",
                    "endsPattern": "^.*\\[TypeScript\\].*"
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "never"
            }
        }
    ]
}